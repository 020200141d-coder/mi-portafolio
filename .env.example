# Copia este archivo como .env y completa los datos.
# Sin SMTP_USER/SMTP_PASS los mensajes del formulario se guardan en mensajes/mensajes.jsonl

PORT=3000

# Gmail: usa una "contraseña de aplicación" (Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# A qué correo llegan los mensajes (si se deja vacío, llegan a SMTP_USER)
CONTACT_TO=020200141d@uandina.edu.pe
