<%# head.ejs — <head> compartido. Recibe `titulo` opcional y `d` (datos del portafolio). %>
<!DOCTYPE html>
<html lang="es" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portafolio de <%= d.perfil.nombre %>: técnico de sonido, pantallas LED y estudiante de Ingeniería de Sistemas.">
  <meta name="theme-color" content="#0a0c0f">
  <title><%= typeof titulo !== 'undefined' ? titulo : `${d.perfil.nombreCorto} ${d.perfil.apellido} — Audio · LED · Software` %></title>

  <%# Aplicamos el tema guardado antes de pintar para evitar el "parpadeo" claro→oscuro. %>
  <script>
    try { var t = localStorage.getItem('tema'); if (t) document.documentElement.setAttribute('data-theme', t); } catch (e) {}
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="<%= base %>css/styles.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%230a0c0f'/><rect x='7' y='14' width='3' height='10' rx='1' fill='%23ff7a18'/><rect x='12.5' y='8' width='3' height='16' rx='1' fill='%23ff7a18'/><rect x='18' y='11' width='3' height='13' rx='1' fill='%23ff7a18'/><rect x='23.5' y='16' width='3' height='8' rx='1' fill='%23ff7a18'/></svg>">
</head>
